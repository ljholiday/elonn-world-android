<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050708">

    <FrameLayout
        android:id="@+id/room_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#081012">

        <android.opengl.GLSurfaceView
            android:id="@+id/ar_surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <FrameLayout
            android:id="@+id/room_world_markers"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/carry_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp">

        <HorizontalScrollView
            android:id="@+id/carry_top_dock_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/carry_top_dock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/carry_dock_background"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingTop="4dp"
                android:paddingEnd="6dp"
                android:paddingBottom="4dp">

                <TextView
                    android:layout_width="70dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/carry_dock_button_background"
                    android:gravity="center"
                    android:text=" "
                    android:textColor="#D7FFF3" />

                <TextView
                    android:layout_width="70dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/carry_dock_button_background"
                    android:gravity="center"
                    android:text=" "
                    android:textColor="#D7FFF3" />

                <TextView
                    android:layout_width="70dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/carry_dock_button_background"
                    android:gravity="center"
                    android:text=" "
                    android:textColor="#D7FFF3" />

                <TextView
                    android:layout_width="70dp"
                    android:layout_height="28dp"
                    android:background="@drawable/carry_dock_button_background"
                    android:gravity="center"
                    android:text=" "
                    android:textColor="#D7FFF3" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/carry_runtime_workspace"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/carry_left_siderail"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="2"
            android:background="@drawable/carry_dock_background"
            android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingTop="9dp"
                android:paddingEnd="10dp"
                android:paddingBottom="10dp">

            <TextView
                android:id="@+id/carry_left_siderail_handle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:text="World Contract"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                android:textStyle="bold" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="8dp"
                    android:layout_weight="1"
                    android:fillViewport="false"
                    android:overScrollMode="ifContentScrolls">

                    <LinearLayout
                        android:id="@+id/carry_left_siderail_items"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>
        </LinearLayout>

            <LinearLayout
                android:id="@+id/carry_active_window"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="6"
                android:background="#E3121718"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="10dp"
                android:visibility="invisible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/active_window_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Surface Stack"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/active_window_close"
                        android:layout_width="64dp"
                        android:layout_height="30dp"
                        android:background="@drawable/carry_dock_button_background"
                        android:gravity="center"
                        android:text="Hide"
                        android:textColor="#D7FFF3"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/active_window_body"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="0dp"
                    android:layout_weight="1"
                    android:minHeight="0dp" />
            </LinearLayout>

        <LinearLayout
            android:id="@+id/carry_right_siderail"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="2"
            android:background="@drawable/carry_dock_background"
            android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingTop="9dp"
                android:paddingEnd="10dp"
                android:paddingBottom="10dp">

            <TextView
                android:id="@+id/carry_right_siderail_handle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:text="Social Menu"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                android:textStyle="bold" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="8dp"
                    android:layout_weight="1"
                    android:fillViewport="false"
                    android:overScrollMode="ifContentScrolls">

                    <LinearLayout
                        android:id="@+id/carry_right_siderail_items"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>
        </LinearLayout>
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/carry_app_dock_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/carry_app_dock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/carry_dock_background"
                android:baselineAligned="false"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="6dp"
                android:paddingEnd="8dp"
                android:paddingBottom="6dp" />
        </HorizontalScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/login_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F2050708"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <LinearLayout
            android:layout_width="360dp"
            android:layout_height="wrap_content"
            android:background="#E3121718"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="16dp"
            android:paddingEnd="18dp"
            android:paddingBottom="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Elonn World"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/login_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Sign in to load your World runtime."
                android:textColor="#D0DDD5"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/login_email"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="14dp"
                android:autofillHints="emailAddress"
                android:hint="Email"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#8EA39B"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/login_password"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:autofillHints="password"
                android:hint="Password"
                android:inputType="textPassword"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#8EA39B"
                android:textSize="15sp" />

            <Button
                android:id="@+id/login_submit"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="14dp"
                android:text="Log in" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
